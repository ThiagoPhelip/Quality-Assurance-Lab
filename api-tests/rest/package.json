{
  "name": "qa-lab-api-contract",
  "version": "1.0.0",
  "private": true,
  "description": "Testes dos contratos HTTP públicos da QAZANDO Shop",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "pretest:ci": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=reports/junit.xml"
  }
}
