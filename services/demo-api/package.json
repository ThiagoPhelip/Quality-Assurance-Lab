{
  "name": "qa-lab-demo-api",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "pretest:ci": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\"",
    "test:ci": "node --test --experimental-test-coverage --test-reporter=junit --test-reporter-destination=reports/junit.xml"
  }
}
